# ===== الخادم =====
PORT=3000
NODE_ENV=production
# عنوان الموقع العام (للروابط وملفات SEO)
PUBLIC_URL=https://example.com
# مسار قاعدة البيانات والملفات المرفوعة (يجب أن يكونا على قرص دائم في الاستضافة)
DATA_DIR=./data
UPLOAD_DIR=./uploads
# عدد الوكلاء الموثوقين أمام التطبيق (1 خلف Render/Fly/Nginx؛ 0 بلا وكيل)
TRUST_PROXY=1

# ===== حساب مدير النظام الأول (يُنشأ عند أول تشغيل إن لم يوجد مدير) =====
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== الذكاء الاصطناعي (المحلل الذكي + تحليل الشارتات) =====
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT_USER=20
AI_DAILY_LIMIT_GUEST=5

# ===== أسعار الأسواق =====
# Twelve Data: https://twelvedata.com  (خطة مجانية محدودة؛ الذهب والفوركس والمؤشرات حسب الخطة)
TWELVEDATA_API_KEY=
# Binance العام للعملات الرقمية (بلا مفتاح، لكنه محجوب في بعض الدول/الاستضافات): on | off
BINANCE_ENABLED=on

# ===== المفكرة الاقتصادية =====
# faireconomy = تغذية JSON عامة (غير رسمية، راجع شروط الاستخدام قبل الاستخدام التجاري)
# fmp = Financial Modeling Prep (يتطلب FMP_API_KEY)
CALENDAR_PROVIDER=faireconomy
FMP_API_KEY=

# ===== البريد (اختياري: التحقق من البريد واستعادة كلمة المرور) =====
# بدون SMTP يعمل النظام لكن رسائل الاستعادة لا تُرسل (يُعرض ذلك بوضوح)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REQUIRE_EMAIL_VERIFICATION=off
